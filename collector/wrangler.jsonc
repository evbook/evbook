// The project's telemetry collector — a separate Worker from EVBook itself,
// deployed only to the project's own account, never by installations.
// See collector/README.md.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "evbook-telemetry",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  // The project's account: this Worker is not meant to be deployed anywhere else.
  "account_id": "239c7c818ff717ce0838e129b2b57527",
  "workers_dev": false,
  "routes": [{ "pattern": "telemetry.evbook.app", "custom_domain": true }],
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "evbook_telemetry" }],
  // Per client address. Instances flush once per ten-minute cron block.
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "4711", "simple": { "limit": 20, "period": 60 } }],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    // The events are the console.log lines; one extra "request happened" line
    // per batch adds nothing but volume.
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  }
}

# Imported by /etc/caddy/Caddyfile (bootstrap.sh appends the one `import` line).
# Kept in its own file: the box may host other sites, so redeploying EVBook
# never rewrites their site blocks.
#
# TLS is Caddy's default HTTP-01 challenge: all three names already resolve to
# this box, so unlike a DNS challenge this needs no API credentials. It keeps working once Cloudflare is in front, because
# Cloudflare exempts /.well-known/acme-challenge/ from its HTTPS redirect and
# Let's Encrypt follows the redirect anyway.
#
# Each block imports `evbook-origin-lock.inc`, which is how these names get
# closed to everything except Cloudflare's edge. bootstrap.sh creates that file
# empty — an empty include is a no-op, so this config is correct both before and
# after the DNS cutover — and deploy/cloudflare/origin-lock.sh fills it in once
# the names are actually proxied. bootstrap.sh never overwrites a filled-in one,
# so a redeploy cannot silently reopen the origin.

# --- the landing page -------------------------------------------------------
evbook.app {
	import /etc/caddy/sites/evbook-origin-lock.inc

	encode gzip zstd

	log {
		output file /var/log/caddy/evbook.access.log
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# The page is one file; only the icons are worth a long cache.
	@assets path /icon.svg /icons/*
	header @assets Cache-Control "public, max-age=604800"

	root * /srv/evbook/current/site
	file_server
}

www.evbook.app {
	# Wrapped in `route` so the lock is evaluated before the redirect. Caddy
	# executes directives in its own fixed order, not the order they are written
	# in, and `redir` sits ahead of `respond` in that order — so without this the
	# redirect answers origin-direct requests and the lock never runs. Inside a
	# `route`, written order is what happens. The other two blocks end in
	# `file_server` and `reverse_proxy`, which Caddy already orders after
	# `respond`, so they do not need this.
	route {
		import /etc/caddy/sites/evbook-origin-lock.inc
		redir https://evbook.app{uri} permanent
	}
}

# --- the demo ---------------------------------------------------------------
demo.evbook.app {
	import /etc/caddy/sites/evbook-origin-lock.inc

	encode gzip zstd

	log {
		output file /var/log/caddy/evbook-demo.access.log
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Vite fingerprints its bundles, so they are safe to cache hard. index.html
	# and the service worker must not be, or a deploy never reaches anyone.
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@nocache path / /index.html /sw.js /manifest.webmanifest
	header @nocache Cache-Control "no-cache"

	# It is a demo with fixture data — keep it out of the index so it never
	# outranks evbook.app for the product's own name.
	header X-Robots-Tag "noindex"

	reverse_proxy 127.0.0.1:3100 {
		health_uri /health_check
		health_interval 30s
		health_timeout 5s
	}
}

{
  "name": "evbook",
  "version": "0.6.0",
  "description": "EVBook — the digital book of your EV's life: drives, charging, battery health, costs and history.",
  "homepage": "https://evbook.app",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "demo": "bun run build:app && bun run build:server && bun demo/seed.mjs && DEMO=true DATABASE_PATH=data/demo/evbook.sqlite PORT=8787 bun dist/server/main.js",
    "demo:seed": "bun demo/seed.mjs --fresh",
    "dev": "bun run generate:migrations && bun run build:app && EVBOOK_R2=true cf dev",
    "dev:app": "bun --bun vite",
    "dev:worker": "bun run generate:migrations && EVBOOK_R2=true cf dev",
    "generate:migrations": "bun scripts/generate-migrations.mjs",
    "build:app": "vite build",
    "build:server": "bun build src/platform/node/main.ts --target=node --format=esm --outfile=dist/server/main.js",
    "dev:node": "bun run build:app && bun src/platform/node/main.ts",
    "migrate:node": "bun src/platform/node/main.ts --migrate-only",
    "setup": "bun scripts/setup.mjs",
    "deploy": "bun run generate:migrations && bun run build:app && cf deploy",
    "deploy:wrangler": "bun run generate:migrations && bun run build:app && rm -rf .cloudflare/output && wrangler deploy",
    "typecheck": "bun --bun tsc -p tsconfig.json --noEmit && bun --bun tsc -p tsconfig.worker.json --noEmit && bun --bun tsc -p tsconfig.node.json --noEmit && bun --bun tsc -p tsconfig.e2e.json --noEmit && bun --bun tsc -p tsconfig.tools.json --noEmit",
    "lint": "bun --bun eslint .",
    "lint:fix": "bun --bun eslint . --fix",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "lock:npm": "npm install --package-lock-only --ignore-scripts --no-audit --no-fund",
    "import": "bun scripts/import.mjs",
    "version": "bun scripts/sync-version.mjs && git add shared/version.ts package-lock.json",
    "test": "bun run test:layout && bun run test:cf-config && bun run test:npm-compat && bun scripts/generate-migrations.mjs --check && bun test && bun run test:workerd",
    "test:workerd": "bun --bun vitest run",
    "test:layout": "bun scripts/check-test-layout.mjs",
    "test:cf-config": "bun scripts/check-cf-config.mjs",
    "test:npm-compat": "bun scripts/check-npm-compat.mjs",
    "types": "wrangler types",
    "migrate:local": "wrangler d1 migrations apply evbook --local",
    "migrate:remote": "node scripts/migrate-remote.mjs",
    "migrate:remote:wrangler": "wrangler d1 migrations apply evbook --remote",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:desktop": "playwright test -c e2e/playwright.config.ts --project desktop",
    "e2e:mobile": "playwright test -c e2e/playwright.config.ts --project mobile",
    "e2e:report": "playwright show-report e2e/.artifacts/report",
    "e2e:seed": "bun e2e/mocks/seed.mjs --db e2e/.state/app.sqlite --fresh",
    "e2e:stop": "bun e2e/harness/stop.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.51.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.8.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.6.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.0",
    "@eslint/js": "^10.0.1",
    "@hono/node-server": "2.1.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/eslint-plugin-query": "^5.101.4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "bun-types": "1.4.4",
    "cf": "1.0.0-beta.28",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.158.0"
  }
}

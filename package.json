{
  "name": "evbook",
  "version": "0.4.0",
  "description": "EVBook — the digital book of your EV's life: drives, charging, battery health, costs and history.",
  "homepage": "https://evbook.app",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "demo": "npm run build:app && npm run build:server && node demo/seed.mjs && DEMO=true DATABASE_PATH=data/demo/evbook.sqlite PORT=8787 node dist/server/main.js",
    "demo:seed": "node demo/seed.mjs --fresh",
    "dev": "npm run generate:migrations && npm run build:app && EVBOOK_R2=true cf dev",
    "dev:app": "vite",
    "dev:worker": "npm run generate:migrations && EVBOOK_R2=true cf dev",
    "generate:migrations": "node scripts/generate-migrations.mjs",
    "build:app": "vite build",
    "build:server": "esbuild src/platform/node/main.ts --bundle --platform=node --target=node22 --format=esm --alias:@shared=./shared --outfile=dist/server/main.js",
    "dev:node": "npm run build:app && npm run build:server && node --env-file-if-exists=.env dist/server/main.js",
    "migrate:node": "npm run build:server && node --env-file-if-exists=.env dist/server/main.js --migrate-only",
    "setup": "node scripts/setup.mjs",
    "deploy": "npm run generate:migrations && npm run build:app && cf deploy",
    "deploy:wrangler": "npm run generate:migrations && npm run build:app && rm -rf .cloudflare/output && wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.e2e.json --noEmit && tsc -p tsconfig.tools.json --noEmit && tsc -p collector/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "import": "node scripts/import.mjs",
    "version": "node scripts/sync-version.mjs && git add shared/version.ts",
    "test": "npm run test:layout && npm run test:cf-config && node scripts/generate-migrations.mjs --check && vitest run && npm run test:node",
    "test:node": "vitest run -c vitest.node.config.ts",
    "test:layout": "node scripts/check-test-layout.mjs",
    "test:cf-config": "node scripts/check-cf-config.mjs",
    "types": "wrangler types",
    "migrate:local": "wrangler d1 migrations apply evbook --local",
    "migrate:remote": "node scripts/migrate-remote.mjs",
    "migrate:remote:wrangler": "wrangler d1 migrations apply evbook --remote",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:desktop": "playwright test -c e2e/playwright.config.ts --project desktop",
    "e2e:mobile": "playwright test -c e2e/playwright.config.ts --project mobile",
    "e2e:report": "playwright show-report e2e/.artifacts/report",
    "e2e:seed": "node e2e/mocks/seed.mjs --db e2e/.state/app.sqlite --fresh",
    "e2e:stop": "node e2e/harness/stop.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.51.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.8.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.6.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.0",
    "@eslint/js": "^10.0.1",
    "@hono/node-server": "2.1.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/eslint-plugin-query": "^5.101.4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "cf": "1.0.0-beta.28",
    "esbuild": "0.28.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.158.0"
  }
}

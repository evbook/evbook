{
  "manifest_version": 3,
  "name": "EVBook Token Helper",
  "short_name": "EVBook Token",
  "version": "1.0.0",
  "description": "Sign in to Tesla and get Owner API tokens for EVBook. Tokens go straight from Tesla to you \u2014 nothing is sent anywhere else.",
  "homepage_url": "https://evbook.app/token-helper/",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Get Tesla tokens",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "webRequest",
    "webNavigation"
  ],
  "host_permissions": [
    "https://auth.tesla.com/*",
    "https://auth.tesla.cn/*"
  ]
}

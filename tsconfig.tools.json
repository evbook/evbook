{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // Node built-ins for the CLI; the SQL types come from src/platform/ports.
    "types": ["node"],
    "paths": { "@shared/*": ["./shared/*"] }
  },
  "include": ["scripts/import", "src/core/import", "src/platform/ports.ts", "cloudflare.config.ts", "wrangler.config.ts"],
  // The specs are checked with the code they cover, by tsconfig.worker.json.
  "exclude": ["**/*.test.ts"]
}

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // shared/version.test.ts reads package.json, to pin APP_VERSION to it.
    "resolveJsonModule": true,
    "types": ["@cloudflare/vitest-pool-workers"],
    "paths": { "@shared/*": ["./shared/*"] }
  },
  "include": ["src", "shared", "test", "worker-configuration.d.ts"],
  // The Node runtime lives on Node built-ins; tsconfig.node.json checks it.
  "exclude": ["src/platform/node"]
}

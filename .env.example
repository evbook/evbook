# Configuration for the Node/VPS runtime (docker compose reads this via
# env_file; Bun loads it on its own for a bare `bun run dev:node`).
# Cloudflare deployments do not use this file — see wrangler.jsonc/.dev.vars.

# What you will log in with, and the key your Tesla tokens are encrypted with.
# Leave both unset for a first boot and the app shows its setup screen; set
# them before real use. Keep ENCRYPTION_KEY safe — losing it means signing in
# to Tesla again.
APP_PASSWORD=
ENCRYPTION_KEY=

# Where the SQLite file lives (the compose file mounts a volume at /data).
#DATABASE_PATH=/data/evbook.sqlite
#PORT=3000

# Where uploaded documents (logbook/title, insurance) are stored, one file per
# document. Keep it on the same volume as the database so one backup covers both.
#BLOBS_DIR=/data/blobs

# Empty = the real services. Point these at fixtures for development.
#TESLA_API_HOST=
#TESLA_AUTH_ISSUER=
#VOLVO_API_HOST=
#VOLVO_AUTH_ISSUER=
# Volvo ID account linking; empty = https://volvo.evbook.app, "off" = own application only.
#VOLVO_LINK_URL=
#NOMINATIM_HOST=
#ELEVATION_HOST=

# "true" silences the minute clock (polling deadlines, geocoding repair). Test
# harnesses use it to freeze seeded data; a real deployment never sets it.
#DISABLE_CRON=

# Once a day the server asks GitHub what the newest release tag is, so the app
# can offer you the update. Nothing is installed for you, and nothing about you
# is sent. "true" turns the whole thing off — Settings then says so instead of
# claiming you are up to date.
#DISABLE_UPDATE_CHECK=
# Which release channel to be told about; empty = "stable" (the only one
# published today). GITHUB_API_HOST changes only which API host is asked
# (empty = https://api.github.com; tests point it at a stub). It does not
# change which repository's tags are checked — that is RELEASE_REPO in
# shared/version.ts, fixed at build time.
#UPDATE_CHANNEL=
#GITHUB_API_HOST=

# The in-app Install button (Cloudflare deployments): pressing it dispatches
# the deploy workflow in this GitHub repository, which builds the tag and
# ships it. UPDATE_REPO empty = the repo releases are tagged in; point it at
# your fork if you deploy from one. The token needs Actions read/write on that
# one repository. Leave the token unset and the app only tells you about
# updates. (A VPS updates with `docker compose pull`; these do nothing for it
# unless the workflow is what deploys your worker.)
#UPDATE_REPO=
#UPDATE_GITHUB_TOKEN=
